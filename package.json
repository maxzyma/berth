{
  "name": "berth-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/vscode"
  ],
  "scripts": {
    "build": "tsc -b packages/core && npm run build -w berth",
    "test": "npm run build && node scripts/test.mjs",
    "test:live": "npm run build && node scripts/test.mjs --live",
    "test:vscode": "npm run build && npm run test:integration -w berth"
  },
  "engines": {
    "node": ">=22"
  }
}
