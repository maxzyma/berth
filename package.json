{
  "name": "berth-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/vscode"
  ],
  "scripts": {
    "build": "tsc -b packages/core && npm run build -w berth",
    "test": "npm run build && node --test --test-concurrency=1 'packages/core/dist/test/**/*.test.js' 'packages/vscode/dist-test/test/**/*.test.js'",
    "test:live": "npm run build && BERTH_LIVE=1 node --test 'packages/core/dist/test/live/*.test.js'",
    "test:vscode": "npm run build && npm run test:integration -w berth"
  },
  "engines": {
    "node": ">=20"
  }
}
