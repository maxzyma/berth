{
  "name": "berth",
  "displayName": "Berth",
  "description": "Every terminal coding agent in one list: kept running in tmux, resumed after restarts, state on your terminal tabs.",
  "icon": "media/icon.png",
  "version": "0.3.6",
  "publisher": "berthdev",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Berth runs tmux and agent CLIs."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "berth",
          "title": "Berth",
          "icon": "media/berth.svg"
        }
      ]
    },
    "views": {
      "berth": [
        {
          "id": "berth.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "berth.new",
        "title": "New Agent Session",
        "category": "Berth",
        "icon": "$(add)"
      },
      {
        "command": "berth.newChooseFolder",
        "title": "New Agent Session in Folder…",
        "category": "Berth",
        "icon": "$(folder-opened)"
      },
      {
        "command": "berth.newInFolder",
        "title": "New Session Here",
        "category": "Berth",
        "icon": "$(add)"
      },
      {
        "command": "berth.nextAttention",
        "title": "Go to Next Session Needing You",
        "category": "Berth",
        "icon": "$(bell)"
      },
      {
        "command": "berth.refresh",
        "title": "Refresh",
        "category": "Berth",
        "icon": "$(refresh)"
      },
      {
        "command": "berth.focus",
        "title": "Show Session",
        "category": "Berth"
      },
      {
        "command": "berth.openToSide",
        "title": "Open to the Side",
        "category": "Berth"
      },
      {
        "command": "berth.detach",
        "title": "Detach",
        "category": "Berth"
      },
      {
        "command": "berth.rename",
        "title": "Rename…",
        "category": "Berth"
      },
      {
        "command": "berth.kill",
        "title": "Kill Session…",
        "category": "Berth"
      },
      {
        "command": "berth.forget",
        "title": "Forget Session…",
        "category": "Berth"
      },
      {
        "command": "berth.adopt",
        "title": "Adopt as Agent Session…",
        "category": "Berth"
      },
      {
        "command": "berth.installHooks",
        "title": "Install Agent Hooks…",
        "category": "Berth"
      },
      {
        "command": "berth.applyLayout",
        "title": "Apply Agent Layout",
        "category": "Berth"
      },
      {
        "command": "berth.revertLayout",
        "title": "Revert Agent Layout",
        "category": "Berth"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "berth.new",
          "when": "view == berth.sessions",
          "group": "navigation@1"
        },
        {
          "command": "berth.nextAttention",
          "when": "view == berth.sessions",
          "group": "navigation@3"
        },
        {
          "command": "berth.refresh",
          "when": "view == berth.sessions",
          "group": "navigation@4"
        },
        {
          "command": "berth.newChooseFolder",
          "when": "view == berth.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "berth.focus",
          "when": "view == berth.sessions && viewItem =~ /^session/",
          "group": "1@1"
        },
        {
          "command": "berth.newInFolder",
          "when": "view == berth.sessions && viewItem == group",
          "group": "inline"
        },
        {
          "command": "berth.newInFolder",
          "when": "view == berth.sessions && viewItem == group",
          "group": "1@0"
        },
        {
          "command": "berth.openToSide",
          "when": "view == berth.sessions && viewItem =~ /^session/",
          "group": "1@2"
        },
        {
          "command": "berth.detach",
          "when": "view == berth.sessions && viewItem =~ /attached-here/",
          "group": "1@3"
        },
        {
          "command": "berth.rename",
          "when": "view == berth.sessions && viewItem =~ /live/",
          "group": "2@1"
        },
        {
          "command": "berth.adopt",
          "when": "view == berth.sessions && viewItem =~ /unmanaged/",
          "group": "2@2"
        },
        {
          "command": "berth.installHooks",
          "when": "view == berth.sessions && viewItem =~ /hooks-missing/",
          "group": "2@3"
        },
        {
          "command": "berth.kill",
          "when": "view == berth.sessions && viewItem =~ /live/",
          "group": "3@1"
        },
        {
          "command": "berth.forget",
          "when": "view == berth.sessions && viewItem =~ /stopped/",
          "group": "3@2"
        }
      ],
      "commandPalette": [
        {
          "command": "berth.focus",
          "when": "false"
        },
        {
          "command": "berth.openToSide",
          "when": "false"
        },
        {
          "command": "berth.detach",
          "when": "false"
        },
        {
          "command": "berth.rename",
          "when": "false"
        },
        {
          "command": "berth.kill",
          "when": "false"
        },
        {
          "command": "berth.adopt",
          "when": "false"
        },
        {
          "command": "berth.newInFolder",
          "when": "false"
        },
        {
          "command": "berth.forget",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Berth",
      "properties": {
        "berth.tmuxSocket": {
          "type": "string",
          "default": "",
          "description": "tmux -L socket name; empty uses the default server."
        },
        "berth.customLauncher": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command that starts an agent session instead of `berth new`, run in the session terminal in the chosen folder. It only has to create a tmux session, run the agent and attach; Berth then finds that session, detects its directory and adopts it (metadata the launcher stamps itself is kept). Placeholders: `{agent}`, `{cwd}` (absolute folder), `{relative}` (folder relative to its workspace folder), `{name}` (folder name). Without `{agent}` the launcher chooses the agent itself. A plain shell is always started by Berth. A launcher usually belongs to one workspace: set it in that workspace's settings. Example: `my-launcher --agent {agent} {relative}`."
        },
        "berth.newSession.order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Agents listed first by *New Session*, in this order (agent ids such as `shell`, `claude`, `codex`); the others follow. Like the launcher, it can differ per workspace."
        },
        "berth.osNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Also show system notifications when an agent waits or finishes."
        },
        "berth.layout.hideTerminalTabs": {
          "type": "boolean",
          "default": false,
          "description": "Let Apply Agent Layout also hide the native terminal tab list in the panel."
        },
        "berth.explorer.followSession": {
          "type": "boolean",
          "default": true,
          "description": "When a session is shown, reveal its folder in the explorer (only for folders inside the workspace)."
        }
      }
    },
    "keybindings": [
      {
        "command": "berth.nextAttention",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.extension.json && tsc -p tsconfig.json && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "test:integration": "vscode-test --config .vscode-test.mjs"
  },
  "dependencies": {
    "@berthdev/berth": "*"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@types/node": "^20.11.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxzyma/berth.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/maxzyma/berth#readme",
  "bugs": {
    "url": "https://github.com/maxzyma/berth/issues"
  },
  "keywords": [
    "tmux",
    "coding agent",
    "claude code",
    "codex",
    "agents",
    "terminal"
  ]
}
