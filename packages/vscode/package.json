{
  "name": "berth",
  "displayName": "Berth",
  "description": "Manage terminal coding agent sessions in VS Code, track attention, and restore verified conversations with tmux.",
  "icon": "media/icon.png",
  "version": "0.4.6",
  "publisher": "berthdev",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Berth runs tmux and agent CLIs."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "berth",
          "title": "Berth",
          "icon": "media/berth-brand-c.svg"
        }
      ]
    },
    "views": {
      "berth": [
        {
          "type": "webview",
          "id": "berth.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "berth.new",
        "title": "New Berth Session",
        "category": "Berth",
        "icon": "$(add)"
      },
      {
        "command": "berth.newChooseFolder",
        "title": "New Berth Session in Folder…",
        "category": "Berth",
        "icon": "$(folder-opened)"
      },
      {
        "command": "berth.newInFolder",
        "title": "New Session Here",
        "category": "Berth",
        "icon": "$(add)"
      },
      {
        "command": "berth.nextAttention",
        "title": "Go to Next Session Needing You",
        "category": "Berth",
        "icon": "$(bell)"
      },
      {
        "command": "berth.markRead",
        "title": "Mark as Read",
        "category": "Berth",
        "icon": "$(check)"
      },
      {
        "command": "berth.refresh",
        "title": "Refresh",
        "category": "Berth",
        "icon": "$(refresh)"
      },
      {
        "command": "berth.focus",
        "title": "Open",
        "category": "Berth"
      },
      {
        "command": "berth.openHere",
        "title": "Open in This Window",
        "category": "Berth"
      },
      {
        "command": "berth.openToSide",
        "title": "Open to the Side",
        "category": "Berth"
      },
      {
        "command": "berth.detach",
        "title": "Detach",
        "category": "Berth"
      },
      {
        "command": "berth.rename",
        "title": "Rename…",
        "category": "Berth"
      },
      {
        "command": "berth.kill",
        "title": "Kill Session…",
        "category": "Berth"
      },
      {
        "command": "berth.forget",
        "title": "Forget Session…",
        "category": "Berth"
      },
      {
        "command": "berth.adopt",
        "title": "Adopt as Agent Session…",
        "category": "Berth"
      },
      {
        "command": "berth.installHooks",
        "title": "Install Agent Hooks…",
        "category": "Berth"
      },
      {
        "command": "berth.applyLayout",
        "title": "Use Berth Layout",
        "category": "Berth"
      },
      {
        "command": "berth.revertLayout",
        "title": "Switch Layout Profile…",
        "category": "Berth"
      },
      {
        "command": "berth.inspectLegacyLayout",
        "title": "Inspect Earlier Layout Backup",
        "category": "Berth"
      },
      {
        "command": "berth.findSession",
        "title": "Find a Session…",
        "category": "Berth",
        "icon": "$(search)"
      },
      {
        "command": "berth.checkSetup",
        "title": "Diagnose Problems…",
        "category": "Berth",
        "icon": "$(checklist)"
      },
      {
        "command": "berth.retryRecovery",
        "title": "Retry Recovery…",
        "category": "Berth",
        "icon": "$(debug-restart)"
      },
      {
        "command": "berth.recoveryFolder",
        "title": "Choose Recovery Folder…",
        "category": "Berth",
        "icon": "$(folder-opened)"
      },
      {
        "command": "berth.recoveryProfile",
        "title": "Choose Recovery Profile…",
        "category": "Berth",
        "icon": "$(folder-opened)"
      },
      {
        "command": "berth.recoveryOptions",
        "title": "Review Recovery Options…",
        "category": "Berth",
        "icon": "$(settings-gear)"
      },
      {
        "command": "berth.checkRecovery",
        "title": "Check Recovery Readiness",
        "category": "Berth",
        "icon": "$(checklist)"
      },
      {
        "command": "berth.moveFolderUp",
        "title": "Move Folder Up",
        "category": "Berth"
      },
      {
        "command": "berth.moveFolderDown",
        "title": "Move Folder Down",
        "category": "Berth"
      },
      {
        "command": "berth.resetFolderOrder",
        "title": "Reset Folder Order",
        "category": "Berth"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "berth.new",
          "when": "view == berth.sessions",
          "group": "navigation@1"
        },
        {
          "command": "berth.nextAttention",
          "when": "view == berth.sessions",
          "group": "2_session@1"
        },
        {
          "command": "berth.refresh",
          "when": "view == berth.sessions",
          "group": "2_session@2"
        },
        {
          "command": "berth.newChooseFolder",
          "when": "view == berth.sessions",
          "group": "navigation@2"
        },
        {
          "command": "berth.findSession",
          "when": "view == berth.sessions",
          "group": "navigation@3"
        },
        {
          "command": "berth.checkSetup",
          "when": "view == berth.sessions",
          "group": "2_setup@1"
        },
        {
          "command": "berth.applyLayout",
          "when": "view == berth.sessions",
          "group": "3_layout@1"
        },
        {
          "command": "berth.revertLayout",
          "when": "view == berth.sessions",
          "group": "3_layout@2"
        },
        {
          "command": "berth.resetFolderOrder",
          "when": "view == berth.sessions",
          "group": "2_session@3"
        }
      ],
      "commandPalette": [
        {
          "command": "berth.focus",
          "when": "false"
        },
        {
          "command": "berth.refresh",
          "when": "false"
        },
        {
          "command": "berth.inspectLegacyLayout",
          "when": "berth.legacyLayout"
        },
        {
          "command": "berth.openHere",
          "when": "false"
        },
        {
          "command": "berth.openToSide",
          "when": "false"
        },
        {
          "command": "berth.detach",
          "when": "false"
        },
        {
          "command": "berth.rename",
          "when": "false"
        },
        {
          "command": "berth.kill",
          "when": "false"
        },
        {
          "command": "berth.adopt",
          "when": "false"
        },
        {
          "command": "berth.newInFolder",
          "when": "false"
        },
        {
          "command": "berth.forget",
          "when": "false"
        },
        {
          "command": "berth.markRead",
          "when": "false"
        },
        {
          "command": "berth.retryRecovery",
          "when": "false"
        },
        {
          "command": "berth.recoveryFolder",
          "when": "false"
        },
        {
          "command": "berth.recoveryProfile",
          "when": "false"
        },
        {
          "command": "berth.recoveryOptions",
          "when": "false"
        },
        {
          "command": "berth.checkRecovery",
          "when": "false"
        },
        {
          "command": "berth.moveFolderUp",
          "when": "false"
        },
        {
          "command": "berth.moveFolderDown",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "berth.focus",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /^session/",
          "group": "1@1"
        },
        {
          "command": "berth.markRead",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /unread/",
          "group": "1@1"
        },
        {
          "command": "berth.newInFolder",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'group'",
          "group": "1@0"
        },
        {
          "command": "berth.openToSide",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /^session/",
          "group": "1@2"
        },
        {
          "command": "berth.detach",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /attached-here/",
          "group": "1@3"
        },
        {
          "command": "berth.rename",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /live/",
          "group": "2@1"
        },
        {
          "command": "berth.adopt",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /unmanaged/",
          "group": "2@2"
        },
        {
          "command": "berth.installHooks",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /hooks-missing/",
          "group": "2@3"
        },
        {
          "command": "berth.kill",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /live/",
          "group": "3@1"
        },
        {
          "command": "berth.forget",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /stopped/",
          "group": "3@2"
        },
        {
          "command": "berth.retryRecovery",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /recovery-retry/",
          "group": "1_session@5"
        },
        {
          "command": "berth.recoveryFolder",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /cwd-missing/",
          "group": "2@4"
        },
        {
          "command": "berth.recoveryProfile",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /profile-unknown/",
          "group": "2@5"
        },
        {
          "command": "berth.recoveryOptions",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /options-required/",
          "group": "2@6"
        },
        {
          "command": "berth.checkRecovery",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'session' && berthItem =~ /agent-session/",
          "group": "2@3"
        },
        {
          "command": "berth.moveFolderUp",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'group'",
          "group": "3_order@1"
        },
        {
          "command": "berth.moveFolderDown",
          "when": "webviewId == 'berth.sessions' && webviewSection == 'group'",
          "group": "3_order@2"
        }
      ],
      "berth.sessionCreation": [
        {
          "command": "berth.new",
          "group": "1_create@1"
        },
        {
          "command": "berth.newChooseFolder",
          "group": "1_create@2"
        }
      ],
      "editor/title": [
        {
          "submenu": "berth.sessionCreation",
          "when": "resourceScheme == vscode-terminal",
          "group": "navigation@-1"
        }
      ],
      "editor/title/context": [
        {
          "command": "berth.new",
          "group": "0_berth@1"
        },
        {
          "command": "berth.newChooseFolder",
          "group": "0_berth@2"
        }
      ],
      "terminal/title/context": [
        {
          "command": "berth.new",
          "group": "0_berth@1"
        },
        {
          "command": "berth.newChooseFolder",
          "group": "0_berth@2"
        }
      ]
    },
    "configuration": {
      "title": "Berth",
      "properties": {
        "berth.tmuxSocket": {
          "type": "string",
          "default": "",
          "description": "tmux -L socket name; empty uses the default server."
        },
        "berth.customLauncher": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command that starts an agent session instead of `berth new`, run in the session terminal in the chosen folder. It only has to create a tmux session, run the agent and attach; Berth then finds that session, detects its directory and adopts it (metadata the launcher stamps itself is kept). Placeholders: `{agent}`, `{cwd}` (absolute folder), `{relative}` (folder relative to its workspace folder), `{name}` (folder name). Without `{agent}` the launcher chooses the agent itself. A plain shell is always started by Berth. A launcher usually belongs to one workspace: set it in that workspace's settings. Example: `my-launcher --agent {agent} {relative}`."
        },
        "berth.newSession.order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Agents listed first by *New Session*, in this order (agent ids such as `shell`, `claude`, `codex`); the others follow. Like the launcher, it can differ per workspace."
        },
        "berth.osNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Also show system notifications when an agent waits or finishes."
        },
        "berth.layout.hideTerminalTabs": {
          "type": "boolean",
          "default": false,
          "description": "Let the new agent layout profile hide the native terminal tab list in the panel."
        },
        "berth.explorer.followSession": {
          "type": "boolean",
          "default": true,
          "description": "When a session is shown, reveal its folder in the explorer (only for folders inside the workspace)."
        },
        "berth.hover.delay": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "markdownDescription": "Milliseconds before a session card shows its hover card. Independent of `#workbench.hover.delay#`, which VS Code does not let an extension change for its own views."
        },
        "berth.view.details": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show compact connection markers on the right of the session title. Full connection details remain available on hover."
        },
        "berth.layout.managedProfile": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Identity of the automatically prepared Berth layout Profile. Managed by Berth; leave unchanged."
        }
      }
    },
    "keybindings": [
      {
        "command": "berth.dismissDetails",
        "key": "escape",
        "when": "berth.detailsVisible"
      },
      {
        "command": "berth.nextAttention",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u"
      }
    ],
    "submenus": [
      {
        "id": "berth.sessionCreation",
        "label": "New Berth Session",
        "icon": {
          "dark": "media/new-session-dark.svg",
          "light": "media/new-session-light.svg"
        }
      }
    ]
  },
  "scripts": {
    "test:webview": "playwright test --config playwright.config.mjs",
    "build": "tsc -p tsconfig.extension.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.json && esbuild src/extension.ts --bundle --platform=node --main-fields=module,main --format=cjs --external:vscode --outfile=dist/extension.cjs && esbuild ../core/src/cli/main.ts --bundle --platform=node --format=esm --outfile=dist/cli.mjs && esbuild src/profileBootstrap.ts --bundle --platform=node --main-fields=module,main --format=cjs --outfile=dist/profile-bootstrap.cjs && node scripts/build-webview.mjs",
    "test:integration": "vscode-test --config .vscode-test.mjs"
  },
  "dependencies": {
    "@berthdev/berth": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.24.0",
    "fflate": "0.8.2",
    "jsonc-parser": "3.3.1",
    "lit": "^3.3.3",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxzyma/berth.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/maxzyma/berth#readme",
  "bugs": {
    "url": "https://github.com/maxzyma/berth/issues"
  },
  "keywords": [
    "tmux",
    "coding agent",
    "claude code",
    "codex",
    "agents",
    "terminal"
  ]
}
